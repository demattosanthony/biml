{
  "name": "biml",
  "version": "0.1.0",
  "description": "Domain-specific language for BIM model generation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bimlc": "./bin/cli.ts"
  },
  "scripts": {
    "build": "langium generate && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch --project tsconfig.build.json",
    "langium:generate": "langium generate",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "langium": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^20.0.0",
    "bun-types": "^1.3.3",
    "langium-cli": "^3.0.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "bin",
    "src"
  ],
  "private": true
}
