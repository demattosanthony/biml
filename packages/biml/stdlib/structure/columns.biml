# Standard Structural Elements Library
# Column and beam types for structural design
# Uses types-only model (no families)

library "stdlib.structure" {
  # ============================================================================
  # Columns
  # ============================================================================

  # Base column type
  type Column {
    param width: Length = 400mm in 200mm..1000mm
    param depth: Length = 400mm in 200mm..1000mm
    ifc_class: IfcColumn
  }

  # Square concrete column
  type ConcreteColumnSquare : Column {
    width = 400mm
    depth = 400mm
  }

  # Rectangular concrete column
  type ConcreteColumnRect : Column {
    width = 400mm
    depth = 600mm
  }

  # Large concrete column
  type ConcreteColumnLarge : Column {
    width = 600mm
    depth = 600mm
  }

  # Steel W-section column
  type SteelColumnW : Column {
    width = 300mm
    depth = 300mm
  }

  # Steel pipe column
  type SteelColumnPipe : Column {
    width = 300mm
    depth = 300mm
  }

  # ============================================================================
  # Beams
  # ============================================================================

  # Base beam type
  type Beam {
    param width: Length = 300mm in 150mm..600mm
    param height: Length = 600mm in 300mm..1200mm
    ifc_class: IfcBeam
  }

  # Concrete beam
  type ConcreteBeam : Beam {
    width = 300mm
    height = 600mm
  }

  # Deep concrete beam
  type ConcreteBeamDeep : Beam {
    width = 300mm
    height = 900mm
  }

  # Steel W-section beam
  type SteelBeamW : Beam {
    width = 200mm
    height = 500mm
  }

  # Steel channel beam
  type SteelBeamChannel : Beam {
    width = 150mm
    height = 300mm
  }
}
