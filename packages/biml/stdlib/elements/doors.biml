# Standard Door Library
# Common door types for architectural design

library "stdlib.doors" {
  # Materials for doors
  material DoorOak {
    color: oak
  }

  material DoorWalnut {
    color: walnut
  }

  material DoorSteel {
    color: steel
  }

  material DoorWhite {
    color: white
  }

  material DoorGlass {
    color: glass
    transparency: 0.2
  }

  # Base door family with standard parameters
  family Door {
    param width: Length = 900mm in 600mm..2400mm
    param height: Length = 2100mm in 1800mm..3000mm
    param thickness: Length = 45mm in 35mm..55mm
  }

  # ============================================================================
  # Single Doors
  # ============================================================================

  # Standard single door - most common residential/commercial door
  type SingleDoor extends Door {
    material: DoorOak
  }

  # Single door with glass panel
  type SingleDoorGlass extends Door {
    material: DoorGlass
  }

  # Narrow utility door
  type UtilityDoor extends Door {
    width = 760mm
    height = 2000mm
    material: DoorSteel
  }

  # Wide accessible door (ADA compliant)
  type AccessibleDoor extends Door {
    width = 1000mm
    material: DoorOak
  }

  # ============================================================================
  # Double Doors
  # ============================================================================

  # Standard double door
  type DoubleDoor extends Door {
    width = 1800mm
    material: DoorOak
  }

  # Wide double door for main entrances
  type DoubleDoorWide extends Door {
    width = 2100mm
    material: DoorWalnut
  }

  # French doors with glass
  type FrenchDoor extends Door {
    width = 1800mm
    material: DoorGlass
  }

  # ============================================================================
  # Fire-Rated Doors
  # ============================================================================

  # 60-minute fire-rated door
  type FireDoor extends Door {
    width = 1000mm
    thickness = 54mm
    material: DoorSteel
  }

  # Fire exit door with panic hardware
  type FireExitDoor extends Door {
    width = 1000mm
    thickness = 54mm
    material: DoorSteel
  }

  # ============================================================================
  # Specialty Doors
  # ============================================================================

  # Sliding door
  type SlidingDoor extends Door {
    width = 1800mm
    material: DoorGlass
  }

  # Pocket door (slides into wall)
  type PocketDoor extends Door {
    width = 900mm
    material: DoorWhite
  }

  # Barn door (surface mounted sliding)
  type BarnDoor extends Door {
    width = 1000mm
    material: DoorOak
  }

  # Bi-fold door
  type BiFoldDoor extends Door {
    width = 1800mm
    material: DoorOak
  }

  # Revolving door
  type RevolvingDoor extends Door {
    width = 2400mm
    height = 2400mm
    material: DoorGlass
  }

  # ============================================================================
  # Commercial Doors
  # ============================================================================

  # Storefront entry
  type StorefrontDoor extends Door {
    width = 1000mm
    height = 2400mm
    material: DoorGlass
  }

  # Automatic sliding door
  type AutomaticDoor extends Door {
    width = 1800mm
    height = 2400mm
    material: DoorGlass
  }

  # Service door (loading dock, etc.)
  type ServiceDoor extends Door {
    width = 1200mm
    height = 2400mm
    material: DoorSteel
  }

  # Overhead door (garage)
  type OverheadDoor extends Door {
    width = 2700mm
    height = 2100mm
    material: DoorSteel
  }
}
