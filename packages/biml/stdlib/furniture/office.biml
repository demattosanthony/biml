# Standard Office Furniture Library
# Common furniture types for office design

library "stdlib.furniture.office" {
  type Desk {
    param width: Length = 1600mm
    param depth: Length = 800mm
    param height: Length = 720mm
    export_class: Furniture
  }

  type StandardDesk : Desk { }

  type Chair {
    param width: Length = 600mm
    param depth: Length = 600mm
    param height: Length = 450mm
    export_class: Furniture
  }

  type OfficeChair : Chair { }

  type Table {
    param width: Length = 1200mm
    param depth: Length = 800mm
    param height: Length = 720mm
    export_class: Furniture
  }

  type ConferenceTable : Table {
    width = 3000mm
    depth = 1200mm
  }

  type Storage {
    param width: Length = 800mm
    param depth: Length = 450mm
    param height: Length = 1800mm
    export_class: Furniture
  }

  type FilingCabinet : Storage {
    width = 450mm
    height = 1400mm
  }
}
