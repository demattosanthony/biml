# BIML Standard Library
# 
# This file serves as documentation for the stdlib structure.
# Individual library files can be imported as needed.
#
# Available libraries:
#
# Materials:
#   - stdlib.materials (common materials: wood, metal, glass, etc.)
#
# Elements:
#   - stdlib.doors (20+ door types)
#   - stdlib.windows (20+ window types)
#
# Furniture:
#   - stdlib.furniture.office (desks, chairs, tables, storage)
#
# Structure:
#   - stdlib.structure (columns, beams)
#
# Usage:
#   import stdlib.doors.{ SingleDoor, DoubleDoor, FireDoor }
#   import stdlib.windows.{ CasementWindow, FixedWindow }
#   import stdlib.furniture.office.{ StandardDesk, OfficeChair }
#
# Or import everything from a library:
#   import stdlib.doors.*
