# Comprehensive BIML Example
# Multi-story office building with all features

import "stdlib/materials/common.biml"
import "stdlib/elements/doors.biml"
import "stdlib/elements/windows.biml"
import "stdlib/furniture/office.biml"

library "Materials" {
  material Oak {
    color: oak
  }

  material Steel {
    color: steel
  }

  material Concrete {
    color: concrete
  }

  material White {
    color: white
  }
}

library "Doors" {
  material WoodOak {
    color: oak
  }

  material SteelGray {
    color: steel
  }

  type Door {
    param width: Length = 900mm
    param height: Length = 2100mm
    param thickness: Length = 45mm
    ifc_class: IfcDoor
  }

  type SingleDoor : Door {
    material: WoodOak
  }

  type DoubleDoor : Door {
    width = 1800mm
    material: WoodOak
  }

  type FireDoor : SingleDoor {
    width = 1000mm
    material: SteelGray
  }
}

library "Windows" {
  material GlassClear {
    color: glass
    transparency: 0.1
  }

  type Window {
    param width: Length = 1200mm
    param height: Length = 1500mm
    param sill_height: Length = 900mm
    ifc_class: IfcWindow
  }

  type FixedWindow : Window {
    material: GlassClear
  }

  type CasementWindow : Window {
    width = 900mm
    material: GlassClear
  }
}

library "Furniture" {
  type Desk {
    param width: Length = 1600mm
    param depth: Length = 800mm
    param height: Length = 720mm
    ifc_class: IfcFurniture
  }

  type Chair {
    param width: Length = 600mm
    param depth: Length = 600mm
    param height: Length = 450mm
    ifc_class: IfcFurniture
  }

  type ConferenceTable {
    param width: Length = 3000mm
    param depth: Length = 1200mm
    param height: Length = 720mm
    ifc_class: IfcFurniture
  }

  type StandardDesk : Desk { }
  type OfficeChair : Chair { }
  type LargeConferenceTable : ConferenceTable { }
}

building "Modern Office Building" {
  defaults {
    wall_thickness: 200mm
    floor_thickness: 200mm
    ceiling_height: 2700mm
    door_height: 2100mm
    window_sill: 900mm
  }

  site "Downtown Campus" at (37.7749, -122.4194)

  # Ground Floor
  level "Ground Floor" at 0m, height: 4m {
    # Perimeter walls
    wall "North" from (0, 20) to (25, 20)
    wall "East" from (25, 20) to (25, 0)
    wall "South" from (25, 0) to (0, 0)
    wall "West" from (0, 0) to (0, 20)

    # Interior walls
    wall "Lobby-East" from (10, 0) to (10, 12)
    wall "Lobby-North" from (0, 12) to (10, 12)
    wall "Corridor-South" from (10, 12) to (25, 12)

    # Main Lobby
    space "Lobby" [public, reception] {
      bounded_by: ["South", "Lobby-East", "Lobby-North", "West"]
      floor: Concrete
      ceiling: White

      door "Main Entry": DoubleDoor in "South" at 5m {
        swing: outward
      }

      place StandardDesk "Reception Desk" at (3, 8), facing north
      place OfficeChair at (3, 7), facing north
    }

    # Open Office Area
    space "Open Office" [office] {
      bounded_by: ["Lobby-East", "East", "Corridor-South", "South"]

      window "W1": FixedWindow in "South" at 15m
      window "W2": FixedWindow in "South" at 20m
      window "W3": FixedWindow in "East" at 5m

      door "Fire Exit": FireDoor in "East" at 10m {
        swing: outward
      }

      # Workstations
      place StandardDesk at (15, 3)
      place OfficeChair at (15, 2), facing north
      place StandardDesk at (20, 3)
      place OfficeChair at (20, 2), facing north
    }

    # Conference Room
    space "Conference Room" [meeting] {
      bounded_by: ["Lobby-North", "North", "West"]

      window "W4": CasementWindow in "North" at 5m
      window "W5": CasementWindow in "West" at 16m

      door "Conf Door": SingleDoor in "Lobby-North" at 5m {
        swing: inward
        connects: "Lobby" <-> "Conference Room"
      }

      place LargeConferenceTable at (5, 16)
    }

    # Back offices
    space "Manager Office" [private, office] {
      bounded_by: ["Corridor-South", "North"]

      window "W6": CasementWindow in "North" at 13.5m

      door "Manager Door": SingleDoor in "Corridor-South" at 13.5m {
        swing: inward
      }

      place StandardDesk at (13.5, 16)
      place OfficeChair at (13.5, 15), facing north
    }

    # Column in lobby
    column "C1" at (5, 6) {
      width: 400mm
      depth: 400mm
    }
  }

  # First Floor (relative elevation)
  level "Level 1" at "Ground Floor".top, height: 3.5m {
    # Perimeter walls aligned with ground floor
    wall "North" from (0, 20) to (25, 20)
    wall "East" from (25, 20) to (25, 0)
    wall "South" from (25, 0) to (0, 0)
    wall "West" from (0, 0) to (0, 20)

    # Interior walls
    wall "Corridor" from (0, 10) to (25, 10)

    # Open plan office
    space "Upper Office" [office] {
      bounded_by: ["South", "East", "Corridor", "West"]

      window "W7": FixedWindow in "South" at 6m
      window "W8": FixedWindow in "South" at 12m
      window "W9": FixedWindow in "South" at 18m

      door "Stair Access": FireDoor in "West" at 5m {
        swing: outward
      }
    }

    # Meeting rooms along corridor
    space "Meeting Room 1" [meeting] {
      bounded_by: ["Corridor", "North", "West"]

      window "W10": CasementWindow in "North" at 4m

      door "Meeting 1 Door": SingleDoor in "Corridor" at 4m {
        swing: inward
      }
    }

    space "Meeting Room 2" [meeting] {
      bounded_by: ["Corridor", "North"]

      window "W11": CasementWindow in "North" at 12m

      door "Meeting 2 Door": AccessibleDoor in "Corridor" at 12m {
        swing: inward
      }
    }
  }
}
