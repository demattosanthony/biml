# Test fixture for hierarchical BIML syntax with library and type system

library "Doors" {
  family Door {
    parameter width: Length = 900mm
    parameter height: Length = 2100mm
  }

  type SingleFlush extends Door { }
  type Corridor90 extends Door {
    width = 900mm
  }
  type DoubleDoor extends Door {
    width = 1800mm
  }
}

project "Test Building" {
  site "Site A" {
    building "Building 1" {
      level "Ground" {
        elevation: 0m
        height: 3.5m

        space "Lobby" {
          position: [0, 0]
          area: 50m²
          door "D1": SingleFlush
        }

        space "Office 101" {
          position: [0, 1]
          width: 5m
          length: 6m
          door "D2": Corridor90 {
            wall: north
          }
        }
      }

      level "Level 1" {
        elevation: 3.5m
        height: 3m

        space "Conference Room" {
          position: [0, 0]
          area: 40m²
          door "D3": DoubleDoor
        }
      }
    }
  }
}
