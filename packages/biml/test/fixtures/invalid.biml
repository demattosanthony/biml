# Invalid BIML v2.1 - for testing error handling
# Uses types-only model (no families)

library "Test" {
  # Base door type with parameters
  type Door {
    param width: Length = 900mm
  }

  type TestDoor : Door { }
}

building "Test Building" {
  level "Ground" at 0m, height: 3m {
    wall "W1" from (0, 0) to (10, 0)

    # Error: Reference to non-existent wall
    door "D1": TestDoor in "NonExistentWall" at 5m

    # Error: Reference to non-existent type
    door "D2": NonExistentType in "W1" at 3m

    space "Room" {
      # Error: Reference to non-existent wall in bounded_by
      bounded_by: ["W1", "NonExistentWall2"]
    }
  }
}
