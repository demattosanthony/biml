# Simple BIML Example (v0.6.0)
# A basic office building with two adjacent rooms, doors, and materials

library "Doors" {
  # Define materials for door finishes
  material WarmOak {
    color: oak
  }

  material DarkWalnut {
    color: walnut
  }

  material WhitePainted {
    color: white
  }

  # Door family and types
  family Door {
    parameter width: Length = 900mm
    parameter height: Length = 2100mm
  }

  type StandardDoor extends Door {
    material: WarmOak
  }

  type InteriorDoor extends Door {
    width = 800mm
    material: WhitePainted
  }

  type WalnutDoor extends Door {
    material: DarkWalnut
  }
}

project "Simple Office" {
  site "Main Site" {
    building "Office Building" {
      level "Ground" {
        elevation: 0m
        height: 3.5m

        space "Reception" {
          position: [0, 0]
          area: 50m²

          # Exterior door with oak finish (inherited from type)
          door "Main Entry": StandardDoor {
            wall: south
            offset: center
          }
        }

        space "Hallway" {
          position: [0, 1]
          width: 2m
          length: 10m

          # Interior door with white finish (inherited from type)
          door "D1": InteriorDoor {
            wall: west
            connects: "Reception"
          }

          # Door with walnut finish via type
          door "D2": WalnutDoor {
            wall: east
            offset: 3m from north
          }
        }
      }
    }
  }
}
