# Simple two-room office with connecting door

library "Doors" {
  family Door {
    parameter width: Length = 900mm
    parameter height: Length = 2100mm
  }

  type StandardDoor extends Door { }
}

project "Simple Office" {
  site "Main Site" {
    building "Office Building" {
      level "Ground" {
        elevation: 0m
        height: 3.5m

        space "Reception" {
          position: [0, 0]
          area: 50m²
          ceiling
          door "D1": StandardDoor
        }

        space "Hallway" {
          position: [0, 1]
          width: 2m
          length: 10m
          ceiling
        }
      }
    }
  }
}
