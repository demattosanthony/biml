# Simple BIML Example
# A basic office with two rooms and connecting door

import "stdlib/elements/doors.biml"
import "stdlib/materials/common.biml"

library "Doors" {
  material WarmOak {
    color: oak
  }

  material WhitePaint {
    color: white
  }

  type Door {
    param width: Length = 900mm
    param height: Length = 2100mm
    ifc_class: IfcDoor
  }

  type SingleDoor : Door {
    material: WarmOak
  }

  type InteriorDoor : Door {
    width = 800mm
    material: WhitePaint
  }
}

building "Simple Office" {
  defaults {
    wall_thickness: 200mm
    ceiling_height: 2700mm
  }

  level "Ground" at 0m, height: 3.5m {
    # Define walls with coordinates
    wall "North" from (0, 10) to (15, 10)
    wall "East" from (15, 10) to (15, 0)
    wall "South" from (15, 0) to (0, 0)
    wall "West" from (0, 0) to (0, 10)
    wall "Interior" from (8, 0) to (8, 10)

    # Reception space on the left
    space "Reception" [public, reception] {
      bounded_by: ["South", "Interior", "North", "West"]

      door "Main Entry": SingleDoor in "South" at 4m {
        swing: outward
      }
    }

    # Office space on the right
    space "Office" [private, office] {
      bounded_by: ["South", "East", "North", "Interior"]

      door "Office Door": InteriorDoor in "Interior" at 5m {
        swing: inward
        connects: "Reception" <-> "Office"
      }
    }
  }
}
