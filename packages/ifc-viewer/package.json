{
  "name": "@biml/ifc-viewer",
  "version": "0.1.0",
  "description": "A React component library for rendering IFC models with a great developer experience",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run build:css",
    "build:css": "cp src/styles.css dist/styles.css",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "ifc",
    "bim",
    "3d",
    "viewer",
    "react",
    "web-ifc",
    "openbim"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@thatopen/components": "^2.4.0",
    "@thatopen/components-front": "^2.4.0",
    "@thatopen/fragments": "^2.4.0",
    "three": "^0.160.0",
    "web-ifc": "^0.0.66"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
}
